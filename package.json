{
  "name": "aba-skills-360",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @aba/web test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "desktop:dev": "pnpm --filter @aba/desktop dev",
    "desktop:dist": "pnpm build && pnpm --filter @aba/desktop dist",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@prisma/client": "6.16.3",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "prisma": "6.16.3",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}